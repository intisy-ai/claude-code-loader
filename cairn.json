{
  "displayName": "Claude Code Loader",
  "icon": "icon.svg",
  "app": {
    "id": "claude",
    "label": "Claude Code",
    "home": {
      "envOverride": "HUB_CLAUDE_DIR",
      "nativeEnv": "CLAUDE_CONFIG_DIR",
      "candidates": ["~/.claude", "~/.config/claude"]
    },
    "detect": { "binary": "claude", "pkg": "@anthropic-ai/claude-code" },
    "loader": { "id": "claude-code-loader", "url": "intisy-ai/claude-code-loader" },
    "commandsSubdir": "commands",
    "proxyPort": 34567,
    "integration": "env-baseurl",
    "wireFormat": "anthropic",
    "usage": { "formats": ["claude-jsonl"] },
    "accent": "#d7875f",
    "wrapperCommand": "cc",
    "discovery": { "topic": "claude-code-plugin" },
    "projects": { "historyFile": "history.jsonl" }
  }
}
