{
  "name": "claude-code-loader",
  "version": "1.13.0",
  "description": "TUI launcher and cc shell command for Claude Code.",
  "main": "dist/plugin.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/claude-code-loader.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "plugin",
    "launcher",
    "tui"
  ],
  "files": [
    "dist/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "claudeHub": {
    "daemon": {
      "script": "dist/proxy.js",
      "runtime": "node",
      "port": 34567,
      "healthCheckUrl": "http://127.0.0.1:34567/health"
    }
  },
  "scripts": {
    "build": "npx tsc && node build.mjs",
    "postbuild": "node dist/plugin.js readme",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@intisy/bayonet": "^1.7.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.12",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@intisy/bayonet": "^1.7.0",
    "@intisy-ai/basekit": "^4.2.0",
    "@intisy-ai/claude-code-proxy": "^2.0.0"
  }
}
